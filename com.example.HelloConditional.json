{
    "app-id": "com.example.HelloConditional",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "hello-conditional",
    "finish-args": [
        "--socket-if=x11:!has-wayland",
        "--socket-if=wayland:has-wayland",
        "--socket-if=pulseaudio:false",
        "--device-if=all:!has-input-device",
        "--device-if=usb:!has-usb-portal",
        "--device-if=dri:has-usb-device",
        "--allow-if=devel:true",
        "--allow-if=multiarch:false",
        "--share-if=network:true",
        "--share-if=ipc:!has-wayland"
    ],
    "modules": [
        {
            "name": "hello-conditional",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 hello.sh /app/bin/hello-conditional"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "hello.sh"
                }
            ]
        }
    ]
}
